# Copy to .env:  cp .env.example .env   (then paste the Gemini API key you were given)
PORT=3000

# Demo admin login (these are also the built-in defaults if left out).
ADMIN_EMAIL=admin@lessondesign.test
ADMIN_PASSWORD=LessonDesign123!

# AI Assist — signed-in users only. Get a key at https://aistudio.google.com/apikey
LDAI_AI_ENABLED=1
LDAI_GEMINI_API_KEY=
LDAI_GEMINI_MODEL=gemini-3.5-flash
LDAI_AI_PROVIDER_ORDER_USER=gemini
LDAI_AI_DAILY_LIMIT_USER=50

# Optional: Azure OpenAI as a fallback provider
LDAI_AZURE_OPENAI_ENDPOINT=
LDAI_AZURE_OPENAI_DEPLOYMENT=
LDAI_AZURE_OPENAI_API_KEY=
